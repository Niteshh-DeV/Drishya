// Prisma 7: no `url` here (it lives in prisma.config.ts), and the generator
// must be `prisma-client` with an explicit output path.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model District {
  id        String @id // "kailali" — same as slug, matches src/data/districts.ts
  slug      String @unique
  name      String
  pcode     String @unique
  areaSqKm  Float
  centerLat Float
  centerLon Float
  tagline   String
  blurb     String

  destinations Destination[]
  blogPosts    BlogPostDistrict[]
}

/// Mirrors the `Destination` type in src/lib/types.ts. List-valued fields
/// (categories, tags, seasons, names, sources, verify flags) live in child
/// tables, and the fixed vocabularies are lookup tables, so a misspelled tag
/// or season is rejected by a foreign key instead of silently stored.
model Destination {
  id         String   @id // "baitadi-tripura-sundari"
  slug       String
  districtId String
  district   District @relation(fields: [districtId], references: [id])

  name        String
  nameNepali  String?
  nearestTown String?

  // null where the source data had no verified coordinates.
  lat        Float?
  lon        Float?
  elevationM Int?

  bestTimeNote    String?
  budget          String
  budgetLevel     BudgetLevel @relation(fields: [budget], references: [name], onUpdate: Cascade)
  budgetNote      String?
  hiddenGem       Boolean
  hiddenGemReason String?

  shortDescription String
  longDescription  String?
  bestFor          String?

  howToGetThere   String?
  entryFee        String?
  openingHours    String?
  nearbyStaysFood String?
  safetyNotes     String?

  /// Credit line shown under the cover photo, for the gallery as a whole.
  photoCredit  String?
  culturalNote String?

  categories     DestinationCategory[]
  interestTags   DestinationInterest[]
  bestSeasons    DestinationSeason[]
  alternateNames DestinationAlternateName[]
  sources        DestinationSource[]
  verifications  DestinationVerification[]
  images         DestinationImage[]
  blogPosts      BlogPostDestination[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([districtId, slug])
  @@index([districtId])
}

/// Cover photo = lowest `sortOrder`; it is not stored separately.
model DestinationImage {
  id               String      @id @default(cuid())
  destinationId    String
  destination      Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  publicId         String      @unique
  secureUrl        String
  originalFilename String
  sortOrder        Int         @default(0)
  credit           String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([destinationId, sortOrder])
}

// ── Lookup tables ────────────────────────────────────────────────────────
// Each row's `name` is identical to the matching string union in
// src/lib/types.ts. Seeded by the migration and kept in sync by prisma/seed.ts.

model Category {
  name         String                @id // "Lake & Wetland"
  destinations DestinationCategory[]
}

model InterestTag {
  name         String                @id // "Trekking"
  destinations DestinationInterest[]
  blogPosts    BlogPostTag[]
}

model Season {
  name         String              @id // "Monsoon"
  /// Calendar order, Spring = 1 … Winter = 5.
  sortOrder    Int                 @unique
  destinations DestinationSeason[]
}

model BudgetLevel {
  name         String        @id // "Low-Medium"
  /// Cheapest = 1, for range comparisons in the recommendation engine.
  rank         Int           @unique
  destinations Destination[]
}

// ── Destination ↔ lookup (many-to-many) ──────────────────────────────────
// `position` keeps the order the content was written in.

model DestinationCategory {
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  categoryName  String
  category      Category    @relation(fields: [categoryName], references: [name], onUpdate: Cascade)
  position      Int

  @@id([destinationId, categoryName])
  @@index([categoryName])
}

model DestinationInterest {
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  tagName       String
  tag           InterestTag @relation(fields: [tagName], references: [name], onUpdate: Cascade)
  position      Int

  @@id([destinationId, tagName])
  @@index([tagName])
}

model DestinationSeason {
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  seasonName    String
  season        Season      @relation(fields: [seasonName], references: [name], onUpdate: Cascade)
  position      Int

  @@id([destinationId, seasonName])
  @@index([seasonName])
}

// ── Destination → many (one-to-many) ─────────────────────────────────────

model DestinationAlternateName {
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  name          String
  position      Int

  @@id([destinationId, name])
}

/// A reference cited by the source doc: a link, a named archive, or both.
model DestinationSource {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  url           String?
  label         String?
  position      Int

  @@index([destinationId, position])
}

/// A `Destination` field the source flagged as unconfirmed, e.g. "entryFee".
model DestinationVerification {
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  field         String

  @@id([destinationId, field])
}

// ── Blog ─────────────────────────────────────────────────────────────────
// Travelers write a post as a title, cover and an ordered list of sections;
// the post page stitches the sections back together. Nothing reaches the
// public site until an admin moves it to `published`.

enum BlogPostStatus {
  draft
  pending
  published
  rejected
}

model BlogPost {
  id      String @id @default(cuid())
  slug    String @unique
  title   String
  /// One or two sentences for cards and link previews.
  excerpt String

  coverPublicId String?
  coverUrl      String?
  coverCredit   String?

  /// Byline as shown on the post; starts as the author's account name.
  authorName String
  /// Null for the team's seeded sample post. A deleted account takes its
  /// posts with it — Facebook's data-deletion rules expect exactly that.
  authorId   String?
  author     User?   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  status      BlogPostStatus @default(draft)
  publishedAt DateTime?
  /// Why the team didn't approve it, shown to the author on "My stories".
  reviewNote  String?

  sections     BlogPostSection[]
  districts    BlogPostDistrict[]
  destinations BlogPostDestination[]
  tags         BlogPostTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([authorId])
}

/// One block of a post. Saving a post replaces its sections wholesale, so
/// `position` is simply 0, 1, 2… in reading order.
model BlogPostSection {
  id            String   @id @default(cuid())
  postId        String
  post          BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  position      Int
  heading       String?
  body          String
  imagePublicId String?
  imageUrl      String?
  imageCaption  String?

  @@index([postId, position])
}

model BlogPostDistrict {
  postId     String
  post       BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  districtId String
  district   District @relation(fields: [districtId], references: [id])

  @@id([postId, districtId])
  @@index([districtId])
}

model BlogPostDestination {
  postId        String
  post          BlogPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  position      Int

  @@id([postId, destinationId])
  @@index([destinationId])
}

model BlogPostTag {
  postId  String
  post    BlogPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  tagName String
  tag     InterestTag @relation(fields: [tagName], references: [name], onUpdate: Cascade)

  @@id([postId, tagName])
  @@index([tagName])
}

// ── Accounts (Auth.js) ───────────────────────────────────────────────────
// User, Account, Session and VerificationToken follow the shape the
// @auth/prisma-adapter expects; `role` is ours. Travelers sign in with
// Google or Facebook — no passwords are stored.

enum UserRole {
  traveler
  guide
  admin
}

model User {
  id    String @id @default(cuid())
  name  String?
  /// Facebook accounts registered with a phone number have no email.
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(traveler)

  accounts  Account[]
  sessions  Session[]
  blogPosts BlogPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Only used by email sign-in, which Drishya doesn't offer yet; the adapter
/// expects the table to exist.
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}
