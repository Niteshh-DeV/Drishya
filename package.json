    "dotenv": "^18.0.5",
    "leaflet": "^1.9.4",
    "lenis": "^1.3.27",
    "motion": "^13.1.1",
    "next": "^16.3.2",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.0",
